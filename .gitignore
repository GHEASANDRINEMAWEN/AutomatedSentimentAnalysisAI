# Secrets
.env

# Python
__pycache__/

# Raw pulls (keep the folder, ignore its contents)
/data/*
!/data/.gitkeep
# ...but do commit a small sample so the data is viewable on GitHub
!/data/sample_records.csv
# ...and the full collected dataset as CSV (requested)
!/data/records.csv
# ...and one generated report, so the PDF export is viewable without running it
!/data/reports/
/data/reports/*
!/data/reports/sample-report.pdf
