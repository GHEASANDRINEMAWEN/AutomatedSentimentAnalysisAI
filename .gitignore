# Secrets
.env

# Python
__pycache__/

# Raw pulls (keep the folder, ignore its contents)
/data/*
!/data/.gitkeep
# ...but do commit a small sample so the data is viewable on GitHub
!/data/sample_records.csv
# ...and the full collected dataset as CSV (requested)
!/data/records.csv
# ...and every generated report, so the whole set is readable on GitHub without
# running the pipeline or holding an API key. PDFs only — the folder still
# ignores anything else that lands in it.
!/data/reports/
/data/reports/*
!/data/reports/*.pdf

# Claude Code session state (worktrees, local agent config)
.claude/
